{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "description": "STACK_VERSION lives in .env.example, where Renovate cannot see it. Bumping it there is what makes the migration workflow replay real data through the new version.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.env\\.example$/"
      ],
      "matchStrings": [
        "STACK_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "elastic/elasticsearch",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Tailscale proxy image version.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.env\\.example$/"
      ],
      "matchStrings": [
        "TAILSCALE_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "docker"
    }
  ]
}
