# Copy to .env and edit. `docker compose` reads .env automatically.
#
#   cp .env.example .env
#
# Every value here is a safe default EXCEPT the passwords and TS_AUTHKEY.
# Change those before running anything you care about.

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Bump STACK_VERSION to upgrade. CI replays the previous version's on-disk
# data through the new version to prove the migration works before you merge.
STACK_VERSION=9.5.0
TAILSCALE_VERSION=v1.102.2

# ---------------------------------------------------------------------------
# Elasticsearch
# ---------------------------------------------------------------------------
# Must stay stable across upgrades: Elasticsearch refuses to start on a data
# directory written by a different cluster name.
CLUSTER_NAME=docker-elk-tailscale
ES_HEAP_SIZE=1g
LS_HEAP_SIZE=512m

ELASTIC_PASSWORD=changeme
KIBANA_SYSTEM_PASSWORD=changeme
LOGSTASH_INTERNAL_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Kibana
# ---------------------------------------------------------------------------
# Encryption keys must be >= 32 characters and must not change between
# restarts, or previously saved objects become permanently unreadable.
# Generate with: openssl rand -hex 32
# Keep at least one letter in each value -- Kibana parses an all-digit
# environment variable as a number and refuses to start.
KIBANA_SECURITY_KEY=changeme_kibana_security_encryption_key_32b
KIBANA_SAVEDOBJECTS_KEY=changeme_kibana_savedobjects_encryption_key
KIBANA_REPORTING_KEY=changeme_kibana_reporting_encryption_key_32

# Public URL Kibana generates links against. Set to the tailnet hostname you
# configured below, with no trailing slash.
KIBANA_PUBLIC_URL=https://kibana.example-tailnet.ts.net

# ---------------------------------------------------------------------------
# Tailscale
# ---------------------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys
# Use a reusable, pre-authorized, tagged key (e.g. tag:elk).
TS_AUTHKEY=

# MagicDNS names the two proxies claim on your tailnet.
TS_KIBANA_HOSTNAME=kibana
TS_LOGSTASH_HOSTNAME=logstash

# Extra flags passed to `tailscale up`, e.g. --advertise-tags=tag:elk
TS_EXTRA_ARGS=

# Compose profiles activated by default. `tailnet` starts the two Tailscale
# proxies. CI overrides this to an empty value to run the stack without them.
COMPOSE_PROFILES=tailnet
